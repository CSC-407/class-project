# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# bcrypt cost factor (12 in production; tests lower it for speed).
BCRYPT_ROUNDS=12
# Fixed one-time code for demos. Leave empty in production to generate random codes.
DEMO_OTP=123456
# Idle session timeout in minutes.
SESSION_IDLE_MINUTES=10
# Set to true only behind HTTPS (sends cookies with the Secure flag).
COOKIE_SECURE=false
